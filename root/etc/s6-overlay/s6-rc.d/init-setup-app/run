#!/command/with-contenv bash
# shellcheck shell=bash

# shellcheck source=/dev/null
source /etc/s6-overlay/scripts/bash-functions

set -e

umask "${UMASK}"

# Update WEBUI_PORTS if PORT was changed from default
if [[ "${PORT}" != "3000" ]]; then
    WEBUI_PORTS="${PORT}/tcp,${PORT}/udp"
    printf '%s' "${WEBUI_PORTS}" > /var/run/s6/container_environment/WEBUI_PORTS
fi

echo "
----------------------------------------------------------------------
ENVIRONMENT APP
----------------------------------------------------------------------
PORT=${PORT}
WEBUI_PORTS=${WEBUI_PORTS}
----------------------------------------------------------------------
"

# Auto-generate OTPRAVKARR_SECRET if not set
if [[ -z "${OTPRAVKARR_SECRET:-}" ]]; then
    echo "WARNING: OTPRAVKARR_SECRET is not set. Generating an ephemeral secret."
    echo "WARNING: Sessions will not persist across container restarts."
    echo "WARNING: Set OTPRAVKARR_SECRET to a stable value for persistent sessions."
    OTPRAVKARR_SECRET="$(head -c 32 /dev/urandom | base64)"
    printf '%s' "${OTPRAVKARR_SECRET}" > /var/run/s6/container_environment/OTPRAVKARR_SECRET
fi

# Ensure the data directory exists and has correct ownership
mkdir -p "${CONFIG_DIR}/data"
find "${CONFIG_DIR}/data" \( ! -user hotio -or ! -group hotio \) -exec chown hotio:hotio {} +
